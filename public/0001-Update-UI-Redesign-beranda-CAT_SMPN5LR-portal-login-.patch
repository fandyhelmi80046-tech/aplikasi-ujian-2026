+                >
+                  <Download size={14} className="text-cyan-600" />
+                  Unduh Patch Git (.patch)
+                </a>
+              </div>
+            </div>
+          </div>
+        </motion.div>
+      </div>
+    </AnimatePresence>
+  );
+}

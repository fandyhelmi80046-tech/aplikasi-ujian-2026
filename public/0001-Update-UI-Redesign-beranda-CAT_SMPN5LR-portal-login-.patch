+
+  const fetchStatus = async () => {
+    try {
+      const res = await fetch('/api/github/status');
+      const data = await res.json();
+      if (data.success) {
+        setStatus(data);
+      }
+    } catch (e) {
+      console.error(e);
+    }
+  };
+
+  useEffect(() => {
+    if (isOpen) {
+      fetchStatus();
+      setResult(null);
+    }
+  }, [isOpen]);
+
+  const handlePush = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!token.trim()) {
+      setResult({
+        success: false,
+        error: 'Harap masukkan Personal Access Token (PAT) GitHub Anda.'
+      });
+      return;
+    }
+
+    setLoading(true);
+    setResult(null);
+
+    try {
+      const res = await fetch('/api/github/push', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json'
+        },
+        body: JSON.stringify({
+          token: token.trim(),
+          force
+        })
+      });
+
+      const data = await res.json();
+      if (data.success) {
+        setResult({
+          success: true,
+          message: data.message || 'Berhasil menimpa repository GitHub secara online!',
+          commit: data.commit
+        });
+        fetchStatus();
+      } else {
+        setResult({
+          success: false,
+          error: data.error || 'Gagal melakukan git push ke GitHub.'
+        });
+      }
+    } catch (err: any) {
+      setResult({
+        success: false,
+        error: err.message || 'Koneksi jaringan terputus saat menghubungi server push.'
+      });
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  if (!isOpen) return null;
+
+  return (
+    <AnimatePresence>
+      <div className="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 overflow-y-auto bg-black/60 backdrop-blur-sm">
